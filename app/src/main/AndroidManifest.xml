<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app update: hand the freshly-downloaded APK to the system package
         installer (the user still confirms the install). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Embedded UnifiedPush distributor: one long-lived socket to push.rcq.app,
         held open by a foreground service. This is the price of background push
         without Google's services, and is what every distributor (ntfy included)
         does. REMOTE_MESSAGING is the Android 14+ service type for exactly this. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Full-screen incoming-call UI over the lock screen (UnifiedPush call wake). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Detect when the user screenshots a notify-mode secure chat (Android 14+). -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Save media to the gallery/Downloads on API ≤ 28; API 29+ uses scoped
         MediaStore which needs no permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Radio (offline BLE discovery + Wi-Fi Direct data session). -->
    <!-- Legacy Bluetooth (API ≤ 30); maxSdk so the new runtime perms take over. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- API 31+ Bluetooth runtime perms; neverForLocation = we don't derive location from BLE. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Wi-Fi Direct data plane. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />

    <application
        android:name=".RcqApp"
        android:allowBackup="false"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RCQ">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.RCQ"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|screenLayout|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Server-join deep link: scanning an rcq://server/<host>?invite=<code>
                 QR with any camera opens the app straight into the join confirm. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rcq" android:host="server" />
            </intent-filter>
            <!-- Connect-to-web deep link: scanning an rcq://link?t=<token>&k=<webEphPub>
                 QR shown on chat.rcq.app opens the app into the link-web confirm. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rcq" android:host="link" />
            </intent-filter>
            <!-- Same connect-to-web link in https form (https://rcq.app/link?t=…&k=…).
                 Stock cameras (Samsung/MIUI/…) often refuse to deep-link a custom
                 rcq:// scheme but DO open https, so the web QR also offers this form;
                 Android shows RCQ in the app chooser (no assetlinks.json yet). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="rcq.app" android:pathPrefix="/link" />
            </intent-filter>
            <!-- Contact deep link (spec §5): rcq://add/<uin>?h=<island>&k=<key> —
                 scanning a contact QR with any camera opens the add-contact
                 confirm; h routes a cross-island add. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rcq" android:host="add" />
            </intent-filter>
            <!-- Same link in https form (https://rcq.app/u/<uin>?h=…). With
                 assetlinks.json served from rcq.app this is an App Link:
                 Android opens RCQ directly instead of offering a chooser (or,
                 worse, silently handing the invite to the browser). That is the
                 whole "a friend scans my QR" path on Android — the in-app
                 scanner we ship is for linking the web client, not contacts. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="rcq.app" android:pathPrefix="/u/" />
            </intent-filter>
            <!-- Group-invite deep link: rcq://group/<id>@<host> + the https form
                 https://rcq.app/g/<id>@<host>. Opening a shared link opens the
                 app into the group-join confirm (foreign host guest-registers). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rcq" android:host="group" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="rcq.app" android:pathPrefix="/g/" />
            </intent-filter>
        </activity>

        <!-- Full-screen incoming-call UI, shown over the lock screen when a
             UnifiedPush call wake arrives. Launched via a full-screen-intent
             notification; hands off to MainActivity on accept. -->
        <activity
            android:name=".call.IncomingCallActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.RCQ" />

        <!-- UnifiedPush: the distributor (ntfy, …) delivers the server's POSTed
             wake payload here. exported=false; the distributor binds by action. -->
        <service
            android:name=".push.RcqPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!-- ── Embedded UnifiedPush distributor ────────────────────────────
             Declaring REGISTER here is also what makes RCQ appear in its own
             distributor chooser: the connector finds distributors by querying
             receivers of that action, and an app may be its own. exported=true
             is required by that query; the receiver refuses any package but
             ours. -->
        <receiver
            android:name=".push.embedded.DistributorReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.distributor.REGISTER" />
                <action android:name="org.unifiedpush.android.distributor.UNREGISTER" />
                <action android:name="org.unifiedpush.android.distributor.MESSAGE_ACK" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".push.embedded.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".push.embedded.PushSocketService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
